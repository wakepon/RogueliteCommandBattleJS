@startuml ScreenFlow
!theme plain

title 画面遷移フロー

[*] --> title

state title {
  title : タイトル画面
  title : - NEW GAME
  title : - CONTINUE (セーブあり)
}

state battle {
  battle : 戦闘画面
  battle : - コマンド選択
  battle : - ターン進行
}

state store {
  store : ストア画面
  store : - 購入/売却
  store : - リロール
  store : - NEXT
}

state event {
  event : イベント画面
  event : - Stage 4のみ
  event : - 選択肢
}

state result {
  result : 結果画面
  result : - 統計表示
  result : - RETURN TO TITLE
}

title --> battle : START_GAME\n(新規)
title --> battle : CONTINUE_GAME\n(ロード)

battle --> store : 勝利\n(Stage 1-3, 5-6)
battle --> event : 勝利\n(Stage 4)
battle --> result : 敗北

store --> battle : 次のStageへ

event --> battle : 次のStageへ

battle --> result : ボス撃破\n(Stage 7勝利)

result --> title : RETURN_TITLE

note right of store
  戦闘終了後にセーブ
  ストア画面開始時は
  セーブ済み状態から
end note

@enduml
